# Demo environment for the local portfolio walkthrough.

APP_NAME="Adaptive Knowledge Graph"
DEBUG=false
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
# Leave empty for local demo. Set a value to require X-API-Key on protected endpoints.
API_KEY=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Opensearch-adaptive-graph123!
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=true

# Use local mode for privacy-first demos. Switch to hybrid only when you need remote fallback.
LLM_MODE=local
LLM_OLLAMA_HOST=http://localhost:11434
LLM_LOCAL_MODEL=llama3.1:8b-instruct-q4_K_M
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mixtral-8x7b-instruct
OPENROUTER_VERIFY_SSL=true

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANKER_ENABLED=false
RERANKER_DEVICE=cpu

RAG_KG_EXPANSION=true
RAG_RETRIEVAL_TOP_K=20
RAG_FINAL_TOP_K=5
RETRIEVAL_MODE=hybrid
VECTOR_BACKEND=opensearch

PRIVACY_LOCAL_ONLY=true
PRIVACY_NO_TRACKING=true

STUDENT_BKT_ENABLED=true
STUDENT_IRT_ENABLED=false
STUDENT_STORAGE_BACKEND=sqlite
STUDENT_PROFILES_DB=data/processed/student_profiles.sqlite3

TRUST_PROXY_HEADERS=false

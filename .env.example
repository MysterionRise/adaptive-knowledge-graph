# Application Settings
APP_NAME="Adaptive Knowledge Graph"
DEBUG=false
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=Admin@123
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Admin@123
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=true

# LLM Configuration
LLM_MODE=local  # local, remote, or hybrid
LLM_LOCAL_BACKEND=ollama  # ollama or llamacpp
LLM_OLLAMA_HOST=http://localhost:11434
LLM_LOCAL_MODEL=llama3.1:8b-instruct-q4_K_M
LLM_MAX_CONTEXT=8192
LLM_TEMPERATURE=0.1
# Fixed Ollama sampling seed; for evaluations use LLM_TEMPERATURE=0 and e.g. LLM_SEED=42
LLM_SEED=

# OpenRouter (for remote/hybrid mode)
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=mistralai/mixtral-8x7b-instruct
OPENROUTER_VERIFY_SSL=true

# Embeddings & Reranking
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda  # cuda or cpu
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Optional Hugging Face revisions (commit SHA, tag or branch). Empty: BGE-M3 loads its pinned
# commit (PINNED_MODEL_REVISIONS in backend/app/core/settings.py), other models their default
# branch; "main" follows the branch.
EMBEDDING_MODEL_REVISION=
RERANKER_MODEL_REVISION=
RERANKER_DEVICE=cuda

# RAG Settings
RAG_KG_EXPANSION=true
RAG_RETRIEVAL_TOP_K=20
RAG_FINAL_TOP_K=5

# Privacy & Compliance
# PRIVACY_LOCAL_ONLY=true (default) keeps questions, textbook context and usage data local.
# The API refuses to start, naming the setting to change, when it finds:
#   - LLM_MODE other than local;
#   - LANGSMITH_TRACING, LANGSMITH_TRACING_V2, LANGCHAIN_TRACING or LANGCHAIN_TRACING_V2 on;
#   - an LLM_OLLAMA_HOST that is not localhost, ollama, host.docker.internal,
#     host.containers.internal, a loopback/private IP, or a name that resolves only to those;
#   - an Ollama cloud model (LLM_LOCAL_MODEL ending in -cloud or :cloud).
# Hugging Face telemetry is always off; the API sets HF_HUB_OFFLINE=1 once the embedding
# (and enabled reranker) models are cached. Set HF_HUB_OFFLINE yourself to override.
PRIVACY_LOCAL_ONLY=true

# Student Model
STUDENT_BKT_ENABLED=true
STUDENT_IRT_ENABLED=false
STUDENT_STORAGE_BACKEND=sqlite
STUDENT_PROFILES_DB=data/processed/student_profiles.sqlite3

# Proxy / rate limiting
TRUST_PROXY_HEADERS=false

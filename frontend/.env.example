# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional. Set to the same value as backend API_KEY when protected demo endpoints are enabled.
NEXT_PUBLIC_API_KEY=

# Development Mode
# Set to 'true' to use mock data when backend is unavailable
NEXT_PUBLIC_USE_MOCK_DATA=false

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

{
  "name": "adaptive-kg-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "playwright test --project=integration",
    "test:integration:headed": "playwright test --project=integration --headed",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "cytoscape": "^3.34.3",
    "cytoscape-cose-bilkent": "^4.1.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.460.0",
    "react-markdown": "^9.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/cytoscape": "^3.31.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.6.7",
    "@playwright/test": "^1.63.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "^5.6.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.5.28",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0"
  }
}

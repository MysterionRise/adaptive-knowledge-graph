{
  "name": "adaptive-kg-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "test:integration": "playwright test --project=integration",
    "test:integration:headed": "playwright test --project=integration --headed",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "cytoscape": "^3.34.3",
    "cytoscape-cose-bilkent": "^4.1.0",
    "axios": "^1.20.0",
    "lucide-react": "^1.52.0",
    "react-markdown": "^10.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/cytoscape": "^3.31.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@playwright/test": "^1.63.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "typescript": "^5.6.0",
    "tailwindcss": "^3.4.19",
    "postcss": "^8.5.28",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.8"
  }
}
